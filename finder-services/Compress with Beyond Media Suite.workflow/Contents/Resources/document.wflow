        <key>ActionBundlePath</key><string>/System/Library/Automator/Run Shell Script.action</string>
        <key>ActionName</key><string>Run Shell Script</string>
        <key>ActionParameters</key>
        <dict>
          <key>COMMAND_STRING</key>
          <string>helper="/Applications/Beyond Media Suite.app/Contents/Resources/finder-tools/BeyondFinderMedia.app/Contents/MacOS/BeyondFinderMedia"
if [ ! -x "$helper" ]; then
  /usr/bin/osascript -e 'display alert "Beyond Media Suite is not installed in Applications." as critical'
  exit 1
fi
"$helper" compress "$@" &gt;/dev/null 2&gt;&amp;1 &amp;</string>
          <key>CheckedForUserDefaultShell</key><true/>
          <key>inputMethod</key><integer>1</integer>
          <key>shell</key><string>/bin/zsh</string>
          <key>source</key><string></string>
        </dict>
